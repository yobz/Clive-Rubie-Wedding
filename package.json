{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --webpack --port 5173",
    "build": "next build",
    "build:vinext": "vinext build",
    "start": "next start --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-app --ignore-pattern .local",
    "db:generate": "drizzle-kit generate",
    "dev:vinext": "vinext dev --port 5173",
    "db:setup": "node scripts/rsvp/setup.mjs",
    "test:dashboard": "node scripts/rsvp/dashboard-qa.mjs",
    "test:rsvp": "node --test scripts/rsvp/*.test.mjs scripts/headcounts.test.mjs",
    "start:vinext": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test": "node --test scripts/rsvp/*.test.mjs scripts/headcounts.test.mjs scripts/music-volume.test.mjs",
    "predev": "node scripts/rsvp/ensure-local-db.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
